# Copy to .env and fill in your own values:   cp .env.example .env
# This file documents variable NAMES ONLY. Never put a real key here.

PORT=8000

# Which provider to try first: openai | groq | gemini
LLM_PROVIDER=openai

# ---- OpenAI ----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.4-mini

# ---- Fallback providers ----
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Per-request budget for a single provider call, seconds
LLM_TIMEOUT_SECONDS=8
