{
  "_meta": {
    "purpose": "Adversarial paraphrase suite for operator-note interpretation.",
    "why": "The ten public cases are not a test set. A plural-noun bug in the relevance guard once survived with all ten green, because no public note says 'inverters' or 'panels'. These cases are written to break things the public set cannot.",
    "conventions": "Windows are start-inclusive and end-exclusive: hours = range(start, end). solar_reduction factor is the fraction REMAINING. minimum_battery_reserve is in kWh; reserve_pct is resolved against capacity_kwh.",
    "capacity_kwh": 200,
    "battery": {
      "capacity_kwh": 200,
      "initial_energy_kwh": 120,
      "minimum_energy_kwh": 40,
      "max_charge_kwh_per_hour": 50,
      "max_discharge_kwh_per_hour": 50
    }
  },
